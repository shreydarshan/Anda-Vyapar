# Anda Vyapar — environment configuration
# Copy this file to .env (same folder as package.json) and fill in your
# own project's values. .env is in .gitignore and must NEVER be committed.
#
# This project uses Supabase's current PUBLISHABLE KEY (starts with
# sb_publishable_), not the legacy anon JWT. Only this public key
# belongs here — it's safe on the client because Row Level Security
# enforces per-user access, not the key itself.
#
# Never put the service_role key or database password in this file —
# they must never exist on any client machine.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
