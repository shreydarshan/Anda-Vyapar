# Anda Vyapar — npm configuration
#
# Fail fast and visibly on install-script errors instead of letting them
# scroll past in a long npm log — surfaces exactly the kind of partial
# Electron install this project's postinstall verifier is designed to
# catch, right when it happens.
foreground-scripts=true

# NOTE: pinning Electron's download cache location (so a corrupted
# cached zip can't silently be reused on every retry) is NOT done here.
# @electron/get reads a raw, unprefixed environment variable
# (electron_config_cache) rather than an npm config key — .npmrc entries
# are only ever exposed to scripts as npm_config_<key>, which install.js
# does not read. A .npmrc entry here would silently do nothing; verified
# by testing both forms directly. See scripts/install.js instead, which
# sets the real environment variable before invoking npm.
